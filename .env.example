# Sao chép file này thành .env
# Khi dev dùng Vite proxy: để rỗng (request /authService đi qua proxy trong vite.config.js)
# Khi build production: đặt thành URL backend thật, vd https://authService.tendomain.com
VITE_API_URL=

# Google OAuth Client ID (Web) — lấy từ Google Cloud Console
VITE_GOOGLE_CLIENT_ID=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
